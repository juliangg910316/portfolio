---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que no deben indexarse (404): sin canonical ni hreflang. */
  noindex?: boolean;
  /**
   * Páginas con slug distinto en cada idioma (artículos del blog, HU-08): ruta de cada traducción que existe.
   * Los idiomas que faltan no llevan hreflang y el selector de idioma lleva a `fallback`.
   */
  translations?: Partial<Record<Lang, string>>;
  /** Ruta sin idioma a la que lleva el selector cuando falta una traducción (p. ej. `/blog/`). */
  fallback?: string;
  ogType?: 'website' | 'article';
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = t('site.title'),
  description = t('site.description'),
  noindex = false,
  translations,
  fallback = '/',
  ogType = 'website',
} = Astro.props;
const langs = Object.keys(languages) as Lang[];
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(Astro.url.pathname);
// Ruta de esta página en cada idioma: la misma ruta con otro prefijo, salvo que se indiquen las traducciones.
const hreflangs: Partial<Record<Lang, string>> = translations
  ? translations
  : Object.fromEntries(langs.map((l) => [l, localizePath(Astro.url.pathname, l)]));
const langLinks = translations
  ? (Object.fromEntries(langs.map((l) => [l, translations[l] ?? localizePath(fallback, l)])) as Record<Lang, string>)
  : undefined;

const ogLocale: Record<Lang, string> = { es: 'es_ES', pt: 'pt_BR', en: 'en_US' };
// Generadas con `npm run og` (scripts/og.ts).
const ogImage = abs(`/og/${lang}.png`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Tema (HU-11): en línea y antes del CSS para que no parpadee. Elección guardada > sistema > oscuro. -->
    <script is:inline data-tema>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('tema');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => hreflangs[l] && <link rel="alternate" hreflang={l} href={abs(hreflangs[l])} />)}
          {hreflangs[defaultLang] && <link rel="alternate" hreflang="x-default" href={abs(hreflangs[defaultLang])} />}
        </Fragment>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Julian Gutierrez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t('blog.rss.title')} href={abs(localizePath('/blog/rss.xml', lang))} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-bg text-ink antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-3 focus:text-white"
      >{t('a11y.skip')}</a
    >
    <Header langLinks={langLinks} />
    <slot />
  </body>
</html>
