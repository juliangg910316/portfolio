---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que no deben indexarse (404): sin canonical ni hreflang. */
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('site.title'), description = t('site.description'), noindex = false } = Astro.props;
const langs = Object.keys(languages) as Lang[];
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(Astro.url.pathname);

const ogLocale: Record<Lang, string> = { es: 'es_ES', pt: 'pt_BR', en: 'en_US' };
// Generadas con `npm run og` (scripts/og.ts).
const ogImage = abs(`/og/${lang}.png`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => (
            <link rel="alternate" hreflang={l} href={abs(localizePath(Astro.url.pathname, l))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={abs(localizePath(Astro.url.pathname, defaultLang))} />
        </Fragment>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Julian Gutierrez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-bg text-ink antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-3 focus:text-white"
      >{t('a11y.skip')}</a
    >
    <Header />
    <slot />
  </body>
</html>
