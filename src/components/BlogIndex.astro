---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { formatDate, isoDate } from '../lib/dates';
import { postMinutes, postPath, postsOf } from '../lib/blog-data';

// Listado del blog (HU-08): solo los artículos de este idioma, del más nuevo al más antiguo.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await postsOf(lang);
---

<Layout title={t('blog.meta.title')} description={t('blog.lead')}>
  <main id="contenido" class="mx-auto max-w-[1200px] px-4 pt-16 pb-24 sm:px-6 lg:pt-22">
    <h1 class="font-display text-[46px] leading-[1.02] font-bold text-ink sm:text-[64px]">{t('blog.title')}</h1>
    <p class="mt-5 max-w-[680px] text-[17px] leading-relaxed text-ink-soft">{t('blog.lead')}</p>
    <a href={localizePath('/blog/rss.xml', lang)} class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-link underline hover:text-ink">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg
      >
      {t('blog.rss')}
    </a>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-ink-muted">{t('blog.empty')}</p>
      ) : (
        <div class="mt-12 grid max-w-[860px] gap-5">
          {posts.map((post) => (
            <article class="relative rounded-[24px] border border-border bg-surface p-6 transition-colors hover:border-sky sm:p-8">
              <p class="flex flex-wrap gap-x-3 text-sm text-ink-muted">
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time>
                <span aria-hidden="true">·</span>
                <span>{t('blog.readingTime').replace('{n}', String(postMinutes(post)))}</span>
              </p>
              <h2 class="mt-2 font-display text-2xl leading-tight font-bold text-ink">
                <a href={postPath(post, lang)} class="after:absolute after:inset-0 after:rounded-[24px] hover:text-sky">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-[16px] leading-relaxed text-ink-soft">{post.data.description}</p>
              <ul aria-label={t('blog.tags')} class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li class="rounded-full border border-border px-3 py-1 text-xs text-ink-soft">{tag}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      )
    }
  </main>
</Layout>
