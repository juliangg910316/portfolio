---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getContactPath } from '../i18n/links';
import type { UiKey } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Cifras reales del CV (docs/historias/HU-01-inicio.md, CA4).
const stats: ReadonlyArray<{ value: string; label: UiKey }> = [
  { value: '10+', label: 'about.stat.years' },
  { value: '~10', label: 'about.stat.apps' },
  { value: '4', label: 'about.stat.devs' },
  { value: '5', label: 'about.stat.countries' },
];
---

<section id="sobre-mi" aria-labelledby="sobre-mi-titulo" class="mx-auto max-w-[1200px] scroll-mt-6 px-4 pb-26 sm:px-6">
  <div class="flex flex-wrap items-center gap-14">
    <div class="flex min-w-0 flex-[1_1_420px] justify-center">
      <!-- [PENDIENTE: foto profesional] → sustituir por <Image> de astro:assets -->
      <div
        class="flex aspect-square w-[340px] max-w-full flex-col items-center justify-center gap-2.5 rounded-full border-[6px] border-primary bg-surface p-6 text-center text-ink-muted"
      >
        <svg
          width="56"
          height="56"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg
        >
        <span class="text-sm">{t('about.photo')}</span>
      </div>
    </div>

    <div class="min-w-0 flex-[1_1_420px]">
      <h2 id="sobre-mi-titulo" class="text-[13px] font-semibold tracking-[0.12em] text-sky uppercase">
        {t('about.title')}
      </h2>
      <p class="mt-2.5 font-display text-[30px] leading-[1.1] font-bold text-ink sm:text-[40px]">
        {t('about.tagline.1')}<br /><span class="text-sky">{t('about.tagline.2')}</span>
      </p>
      <p class="mt-4.5 text-[17px] leading-[1.65] text-ink-soft">{t('about.text')}</p>

      <dl class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          stats.map((s) => (
            <div
              data-testid="cifra"
              class="flex flex-col-reverse justify-end rounded-2xl border border-border bg-surface p-4 text-center"
            >
              <dt class="mt-1 text-[13px] text-ink-muted">{t(s.label)}</dt>
              <dd class="font-display text-[28px] font-bold text-ink">{s.value}</dd>
            </div>
          ))
        }
      </dl>

      <a
        href={getContactPath(lang)}
        class="mt-7 inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-6 text-[15px] font-semibold text-white no-underline hover:bg-primary-deep"
      >
        {t('about.cta')}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </div>
  </div>
</section>
