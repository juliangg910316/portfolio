---
import type { Lang } from '../i18n/ui';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { localizePath, useTranslations } from '../i18n/utils';
import { localize, type ProjectData } from '../lib/projects';

interface Props {
  id: string;
  data: ProjectData;
  lang: Lang;
  /** Mostrar el resumen (en el carrusel del inicio se omite). */
  summary?: boolean;
}

const { id, data, lang, summary = true } = Astro.props;
const t = useTranslations(lang);
const name = localize(data.name, lang);
// Solo los destacados tienen caso de estudio (HU-04).
const href = data.featured ? localizePath(`/proyectos/${id}/`, lang) : undefined;

// HU-15: logo de la app a la izquierda del nombre (decorativo: el nombre ya está en el título).
// Sin logo, un icono genérico de móvil.
const logos = import.meta.glob<ImageMetadata>('../assets/logos/*', { eager: true, import: 'default' });
const logo = data.logo ? logos[`../assets/logos/${data.logo}`] : undefined;
if (data.logo && !logo) throw new Error(`Falta el logo src/assets/logos/${data.logo}`);

const badge = 'rounded-full border border-border bg-bg px-2.5 py-1 text-xs font-semibold';
---

<article
  id={id}
  data-category={data.category}
  class="group relative flex h-full scroll-mt-6 flex-col gap-3 rounded-[20px] border border-border bg-surface p-[18px] text-ink transition-colors hover:border-sky"
>
  <div class="flex items-start gap-3.5">
    {
      logo ? (
        <div data-logo aria-hidden="true" class="size-14 flex-none">
          <Image
            src={logo}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            format={logo.format === 'svg' ? 'svg' : 'webp'}
            loading="lazy"
            class="size-14 rounded-[14px] bg-white object-contain ring-1 ring-border"
          />
        </div>
      ) : (
        <div
          data-thumb
          aria-hidden="true"
          class="flex size-14 flex-none items-center justify-center rounded-[14px] bg-primary-deep/40 text-link ring-1 ring-border"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="2" width="12" height="20" rx="2.5" />
            <path d="M11 18h2" />
          </svg>
        </div>
      )
    }
    <div class="min-w-0 flex-1 pt-0.5">
      <h3 class="font-display text-lg leading-tight font-bold">
        {
          href ? (
            <a
              href={href}
              class="text-ink no-underline after:absolute after:inset-0 after:rounded-[20px] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-sky"
            >
              {name}
            </a>
          ) : (
            name
          )
        }
      </h3>
      <p data-testid="tipo" class="mt-1 text-[13px] text-ink-muted">{localize(data.kind, lang)}</p>
    </div>
    {
      href && (
        <span
          aria-hidden="true"
          class="flex size-9 flex-none items-center justify-center rounded-full border-[1.5px] border-sky text-ink group-hover:bg-sky group-hover:text-bg"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      )
    }
  </div>

  {
    (data.internal || data.inDevelopment || data.fullStack) && (
      <p class="flex flex-wrap gap-1.5">
        {data.internal && <span class:list={[badge, 'text-warning']}>{t('projects.badge.internal')}</span>}
        {data.inDevelopment && <span class:list={[badge, 'text-link']}>{t('projects.badge.dev')}</span>}
        {data.fullStack && <span class:list={[badge, 'text-success']}>{t('projects.badge.fullstack')}</span>}
      </p>
    )
  }

  {summary && <p class="text-sm leading-relaxed text-ink-soft">{localize(data.summary, lang)}</p>}
  <ul aria-label={t('projects.stack')} class="mt-auto flex flex-wrap gap-1.5 pt-1">
    {data.stack.map((tech) => <li class="rounded-full border border-border px-2.5 py-1 text-xs text-ink-soft">{tech}</li>)}
  </ul>
</article>
