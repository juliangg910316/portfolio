---
import { languages, type Lang } from '../i18n/ui';
import { alternatePath, getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { getNavItems } from '../i18n/links';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);
const navItems = getNavItems(lang);
const langs = Object.keys(languages) as Lang[];
---

<header class="mx-auto max-w-[1200px] px-4 pt-6 sm:px-6">
  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-[20px] border border-border bg-surface py-2.5 pr-3 pl-4 sm:pl-5"
  >
    <a href={localizePath('/', lang)} class="flex min-h-11 items-center gap-2.5 text-ink no-underline">
      <span
        aria-hidden="true"
        class="flex size-10 items-center justify-center rounded-xl bg-primary font-display text-[17px] font-bold text-white"
        >JG</span
      >
      <span class="font-display text-lg font-bold max-[399px]:sr-only">Julian<span class="text-sky">.dev</span></span>
    </a>

    <nav aria-label={t('nav.label')} class="order-last w-full lg:order-none lg:w-auto">
      <ul class="flex flex-wrap gap-x-5 lg:gap-x-6">
        {
          navItems.map((item) => {
            const isCurrent = normalize(item.href) === current;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-11 items-center border-b-2 text-[15px] no-underline hover:text-ink',
                    isCurrent ? 'border-sky font-semibold text-ink' : 'border-transparent text-ink-soft',
                  ]}
                >
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
    <nav aria-label={t('lang.label')}>
      <ul class="flex rounded-full border border-border bg-bg p-[3px]">
        {
          langs.map((l) => (
            <li>
              <a
                href={alternatePath(Astro.url.pathname, l)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'flex h-11 min-w-11 items-center justify-center rounded-full px-2 text-[13px] no-underline',
                  l === lang ? 'bg-sky font-semibold text-bg' : 'text-ink-soft hover:text-ink',
                ]}
              >
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="sr-only">{languages[l]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Tema (HU-11): el aria-label describe la acción siguiente; lo actualiza el script según data-theme. -->
    <button
      id="tema"
      type="button"
      aria-label={t('theme.toLight')}
      data-to-light={t('theme.toLight')}
      data-to-dark={t('theme.toDark')}
      class="theme-toggle flex size-11 items-center justify-center rounded-full border border-border bg-bg text-ink-soft hover:border-sky hover:text-ink"
    >
      <svg class="light:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="hidden light:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
      </svg>
    </button>
    </div>
  </div>
</header>

<script>
  // Cambio de tema (HU-11). El tema inicial lo fija el script en línea de Layout.astro.
  const button = document.getElementById('tema');
  const root = document.documentElement;
  const system = window.matchMedia?.('(prefers-color-scheme: light)');

  const stored = () => {
    try {
      return localStorage.getItem('tema');
    } catch {
      return null;
    }
  };
  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    button?.setAttribute('aria-label', (theme === 'light' ? button.dataset.toDark : button.dataset.toLight) ?? '');
  };

  apply(root.dataset.theme === 'light' ? 'light' : 'dark');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    apply(next);
    try {
      localStorage.setItem('tema', next);
    } catch {
      // Sin almacenamiento (modo privado estricto): el tema dura hasta cambiar de página.
    }
  });

  // Mientras no se elija un tema, se sigue al sistema.
  system?.addEventListener('change', (event) => {
    if (!stored()) apply(event.matches ? 'light' : 'dark');
  });
</script>
