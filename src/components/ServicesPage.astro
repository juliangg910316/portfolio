---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { getContactPath } from '../i18n/links';
import { localize } from '../lib/projects';
import type { UiKey } from '../i18n/ui';

// Servicios (HU-06). Sin precios por ahora.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const services = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const steps = [1, 2, 3, 4, 5].map((n) => ({
  title: `services.step${n}.title` as UiKey,
  text: `services.step${n}.text` as UiKey,
}));
const eyebrow = 'text-[13px] font-semibold tracking-[0.12em] text-sky uppercase';
---

<Layout title={t('services.meta.title')} description={t('services.lead')}>
  <main id="contenido" class="mx-auto max-w-[1200px] px-4 pt-16 pb-24 sm:px-6 lg:pt-22">
    <h1 class="font-display text-[46px] leading-[1.02] font-bold text-ink sm:text-[64px]">{t('services.title')}</h1>
    <p class="mt-5 max-w-[680px] text-[17px] leading-relaxed text-ink-soft">{t('services.lead')}</p>

    <ul aria-label={t('services.title')} class="mt-12 grid gap-5 md:grid-cols-2">
      {
        services.map((s, i) => (
          <li class="flex flex-col rounded-[24px] border border-border bg-surface p-6 sm:p-8">
            <span aria-hidden="true" class="font-display text-sm font-bold text-sky">
              0{i + 1}
            </span>
            <h2 class="mt-2 font-display text-2xl leading-tight font-bold text-ink">{s.data.title[lang]}</h2>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-soft">{s.data.summary[lang]}</p>
            <h3 id={`incluye-${s.id}`} class:list={[eyebrow, 'mt-6']}>
              {t('services.includes')}
            </h3>
            <ul aria-labelledby={`incluye-${s.id}`} class="mt-3 flex-1 space-y-2 text-[15px] leading-relaxed text-ink-soft">
              {s.data.includes.map((item) => (
                <li class="relative pl-6">
                  <svg
                    class="absolute top-[0.3em] left-0 text-success"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {item[lang]}
                </li>
              ))}
            </ul>
            <p class="mt-6 border-t border-border pt-5 text-[15px] text-ink-muted">
              <span class="font-semibold text-ink">{t('services.example')}:</span>{' '}
              <a href={localizePath(s.data.example.path, lang)} class="font-semibold text-link underline hover:text-ink">
                {localize(s.data.example.name, lang)}
              </a>{' '}
              · {s.data.example.note[lang]}
            </p>
          </li>
        ))
      }
    </ul>

    <section aria-labelledby="proceso-titulo" class="mt-20">
      <h2 id="proceso-titulo" class="font-display text-[30px] leading-[1.1] font-bold text-ink sm:text-[40px]">
        {t('services.process')}
      </h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((step, i) => (
            <li class="rounded-[20px] border border-border bg-surface p-5">
              <span
                aria-hidden="true"
                class="flex size-9 items-center justify-center rounded-full bg-primary font-display font-bold text-white"
              >
                {i + 1}
              </span>
              <h3 class="mt-4 font-display text-lg leading-tight font-bold text-ink">{t(step.title)}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{t(step.text)}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      aria-labelledby="presupuesto-titulo"
      class="mt-20 flex flex-wrap items-center justify-between gap-6 rounded-[28px] border border-border bg-surface p-8 sm:p-10"
    >
      <div class="max-w-[560px]">
        <h2 id="presupuesto-titulo" class="font-display text-[26px] leading-tight font-bold text-ink sm:text-[32px]">
          {t('services.cta.title')}
        </h2>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-soft">{t('services.cta.text')}</p>
      </div>
      <a
        href={getContactPath(lang, 'proyecto')}
        class="inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-7 text-[15px] font-semibold text-white hover:bg-primary-deep"
      >
        {t('services.cta.button')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </section>
  </main>
</Layout>
