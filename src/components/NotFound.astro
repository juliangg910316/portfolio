---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('notfound.meta.title')} description={t('notfound.text')} noindex>
  <main id="contenido" class="mx-auto max-w-[1200px] px-4 pt-16 pb-24 sm:px-6 lg:pt-22">
    <p class="font-display text-[13px] font-semibold tracking-[0.12em] text-sky">404</p>
    <h1 class="mt-2.5 font-display text-[46px] leading-[1.02] font-bold text-ink sm:text-[64px]">{t('notfound.title')}</h1>
    <p class="mt-5 max-w-[620px] text-[17px] leading-relaxed text-ink-soft">{t('notfound.text')}</p>
    <a
      href={localizePath('/', lang)}
      class="mt-8 inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-6 text-[15px] font-semibold text-white no-underline hover:bg-primary-deep"
    >
      {t('notfound.home')}
    </a>
  </main>
</Layout>
