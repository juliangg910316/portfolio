---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { getContactPath } from '../i18n/links';
import { localize, neighbors, splitProjects } from '../lib/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { featured } = splitProjects(await getCollection('proyectos'));
const index = featured.findIndex((p) => p.id === slug);
const project = featured[index];
const entry = await getEntry('casos', `${lang}/${slug}`);
if (!project || !entry) throw new Error(`Falta el caso de estudio ${lang}/${slug}`);

const { Content, headings } = await render(entry);
const { prev, next } = neighbors(featured, index);
const { data } = project;
const name = localize(data.name, lang);
const caseHref = (id: string) => localizePath(`/proyectos/${id}/`, lang);
const linkLabel = (l: (typeof data.links)[number]) =>
  l.type === 'store' ? t('case.link.store').replace('{store}', l.store ?? '') : t(`case.link.${l.type}`);
const badge = 'rounded-full border border-border bg-bg px-3 py-1 text-xs font-semibold';
---

<Layout title={`${name} · ${t('case.meta.suffix')} · Julian Gutierrez`} description={localize(data.summary, lang)}>
  <main id="contenido" class="mx-auto max-w-[1200px] px-4 pt-12 pb-24 sm:px-6 lg:pt-16">
    <a href={localizePath('/proyectos/', lang)} class="inline-flex min-h-11 items-center gap-2 text-[15px] text-link hover:text-ink">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M19 12H5M11 6l-6 6 6 6"></path></svg
      >
      {t('case.back')}
    </a>

    <header class="mt-6 max-w-[760px]">
      {
        (data.internal || data.inDevelopment || data.fullStack) && (
          <p class="mb-4 flex flex-wrap gap-2">
            {data.internal && <span class:list={[badge, 'text-warning']}>{t('projects.badge.internal')}</span>}
            {data.inDevelopment && <span class:list={[badge, 'text-link']}>{t('projects.badge.dev')}</span>}
            {data.fullStack && <span class:list={[badge, 'text-success']}>{t('projects.badge.fullstack')}</span>}
          </p>
        )
      }
      <h1 class="font-display text-[40px] leading-[1.05] font-bold text-ink sm:text-[56px]">{name}</h1>
      <p class="mt-3 font-display text-xl font-medium text-link">{localize(data.kind, lang)}</p>
      <p class="mt-4 text-[17px] leading-relaxed text-ink-soft">{localize(data.summary, lang)}</p>

      <ul aria-label={t('projects.stack')} class="mt-5 flex flex-wrap gap-2">
        {data.stack.map((tech) => <li class="rounded-full border border-border px-3 py-1 text-sm text-ink-soft">{tech}</li>)}
      </ul>

      {
        data.links.length > 0 && (
          <ul aria-label={t('case.links')} class="mt-6 flex flex-wrap gap-3">
            {data.links.map((l) => (
              <li>
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-12 items-center gap-2 rounded-full border-[1.5px] border-sky px-5 text-[15px] font-semibold text-ink hover:bg-surface"
                >
                  {linkLabel(l)}
                  <span class="sr-only">{t('case.newtab')}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      data.demo && (
        <section
          aria-labelledby="demo-titulo"
          class="mt-10 max-w-[760px] rounded-[20px] border border-border bg-surface p-6 sm:p-8"
          data-demo={data.demo}
          data-demo-title={t('case.demo.frame').replace('{name}', name)}
        >
          <h2 id="demo-titulo" class="font-display text-2xl font-bold text-ink">{t('case.demo.title')}</h2>
          <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{t('case.demo.text')}</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
            {/* Sin JS o en el móvil es un enlace normal: abre la demo a pantalla completa (CA3). */}
            <a
              href={data.demo}
              data-demo-try
              class="inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-6 text-[15px] font-semibold text-white hover:bg-primary-deep"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              {t('case.demo.try')}
            </a>
            <a href={data.demo} class="inline-flex min-h-11 items-center text-[15px] font-semibold text-link underline hover:text-ink">
              {t('case.demo.full')}
            </a>
          </div>
          <div data-demo-slot class="hidden"></div>
        </section>
      )
    }

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_220px]">
      <article class="prose-caso min-w-0 max-w-[760px]">
        <Content />
      </article>
      <nav aria-label={t('case.toc')} class="hidden lg:block">
        <div class="sticky top-6 rounded-2xl border border-border bg-surface p-5">
          <p class="text-[13px] font-semibold tracking-[0.12em] text-sky uppercase">{t('case.toc')}</p>
          <ul class="mt-3 space-y-1">
            {
              headings
                .filter((h) => h.depth === 2)
                .map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="block py-1.5 text-sm text-ink-soft hover:text-ink">
                      {h.text}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <section aria-labelledby="caso-cta" class="mt-16 max-w-[760px] rounded-[20px] border border-border bg-surface p-6 sm:p-8">
      <h2 id="caso-cta" class="font-display text-2xl font-bold text-ink">{t('case.cta.title')}</h2>
      <a
        href={getContactPath(lang)}
        class="mt-5 inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-6 text-[15px] font-semibold text-white hover:bg-primary-deep"
      >
        {t('case.cta.button')}
      </a>
    </section>

    <nav aria-label={t('case.nav')} class="mt-10 grid max-w-[760px] gap-3 sm:grid-cols-2">
      <a href={caseHref(prev.id)} class="flex min-h-11 flex-col rounded-2xl border border-border p-4 hover:border-sky">
        <span class="text-[13px] text-ink-muted">← {t('case.prev')}</span>
        <span class="mt-1 font-display text-lg font-bold text-ink">{localize(prev.data.name, lang)}</span>
      </a>
      <a href={caseHref(next.id)} class="flex min-h-11 flex-col rounded-2xl border border-border p-4 text-right hover:border-sky">
        <span class="text-[13px] text-ink-muted">{t('case.next')} →</span>
        <span class="mt-1 font-display text-lg font-bold text-ink">{localize(next.data.name, lang)}</span>
      </a>
    </nav>
  </main>
</Layout>

<script>
  // HU-13: en pantallas anchas, «Probar demo» incrusta la demo en lugar de navegar.
  // El iframe se crea al pulsar, así la página no descarga la demo antes (CA1).
  const section = document.querySelector<HTMLElement>('[data-demo]');
  const trigger = section?.querySelector<HTMLAnchorElement>('[data-demo-try]');
  const slot = section?.querySelector<HTMLElement>('[data-demo-slot]');
  trigger?.addEventListener('click', (event) => {
    if (!section || !slot || !window.matchMedia?.('(min-width: 768px)').matches) return;
    event.preventDefault();
    const iframe = document.createElement('iframe');
    iframe.src = section.dataset.demo!;
    iframe.title = section.dataset.demoTitle!;
    iframe.className = 'mx-auto block h-[760px] w-full max-w-[400px] rounded-[28px] border-4 border-border bg-bg';
    slot.replaceChildren(iframe);
    slot.classList.remove('hidden');
    slot.classList.add('mt-6');
    trigger.remove();
    iframe.focus();
  });
</script>
