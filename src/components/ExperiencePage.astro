---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getCvPath } from '../i18n/links';
import { formatMonth } from '../lib/dates';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const jobs = (await getCollection('experiencia')).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('formacion')).sort((a, b) => a.data.order - b.data.order);
const present = { es: 'actualidad', pt: 'atual', en: 'present' }[lang];
---

<Layout title={t('exp.meta.title')} description={t('exp.lead')}>
  <main id="contenido" class="mx-auto max-w-[1200px] px-4 pt-16 pb-24 sm:px-6 lg:pt-22">
    <h1 class="font-display text-[46px] leading-[1.02] font-bold text-ink sm:text-[64px]">{t('exp.title')}</h1>
    <p class="mt-5 max-w-[680px] text-[17px] leading-relaxed text-ink-soft">{t('exp.lead')}</p>
    <a
      href={getCvPath(lang)}
      download
      type="application/pdf"
      class="mt-8 inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-6 text-[15px] font-semibold text-white hover:bg-primary-deep"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg
      >
      {t('hero.cv')}
    </a>

    <section aria-labelledby="trayectoria-titulo" class="mt-16">
      <h2 id="trayectoria-titulo" class="text-[13px] font-semibold tracking-[0.12em] text-sky uppercase">
        {t('exp.timeline')}
      </h2>
      <ol aria-label={t('exp.timeline')} class="mt-6 max-w-[860px] border-l-2 border-border">
        {
          jobs.map((job) => (
            <li class="relative pb-10 pl-6 last:pb-0 sm:pl-8">
              <span aria-hidden="true" class="absolute top-1.5 -left-[9px] size-4 rounded-full border-4 border-bg bg-sky" />
              <h3 class="font-display text-xl leading-tight font-bold text-ink sm:text-2xl">{job.data.role[lang]}</h3>
              <p data-testid="empresa" class="mt-1 font-semibold text-link">
                {job.data.company}
              </p>
              <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm text-ink-muted">
                <span>
                  <time datetime={job.data.start}>{formatMonth(job.data.start, lang)}</time> –{' '}
                  {job.data.end ? <time datetime={job.data.end}>{formatMonth(job.data.end, lang)}</time> : present}
                </span>
                <span aria-hidden="true">·</span>
                <span data-testid="lugar">{job.data.location[lang]}</span>
              </p>
              <ul aria-label={t('exp.achievements')} class="mt-4 space-y-2 text-[16px] leading-relaxed text-ink-soft">
                {job.data.achievements.map((a) => (
                  <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:size-1.5 before:rounded-full before:bg-sky">
                    {a[lang]}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="formacion-titulo" class="mt-16 max-w-[860px]">
      <h2 id="formacion-titulo" class="text-[13px] font-semibold tracking-[0.12em] text-sky uppercase">
        {t('exp.education')}
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          education.map((e) => (
            <li class="rounded-[20px] border border-border bg-surface p-6">
              <h3 class="font-display text-xl font-bold text-ink">{e.data.degree[lang]}</h3>
              <p class="mt-1 text-sm text-ink-muted">
                {e.data.institution} · {e.data.years}
              </p>
              {e.data.detail && <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{e.data.detail[lang]}</p>}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
