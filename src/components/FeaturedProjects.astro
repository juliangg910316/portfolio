---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { splitProjects } from '../lib/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { featured } = splitProjects(await getCollection('proyectos'));
const arrow = 'flex size-12 items-center justify-center rounded-full border-[1.5px] border-sky text-ink hover:bg-sky hover:text-bg';
---

<section aria-labelledby="inicio-proyectos-titulo" class="mx-auto max-w-[1200px] px-4 pb-24 sm:px-6">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-[13px] font-semibold tracking-[0.12em] text-sky uppercase">{t('nav.projects')}</p>
      <h2 id="inicio-proyectos-titulo" class="mt-2.5 font-display text-[30px] leading-[1.1] font-bold text-ink sm:text-[40px]">
        {t('home.projects.title')}
      </h2>
    </div>
    <!-- Las flechas solo aparecen con JavaScript; sin él, el carrusel se desplaza con el dedo o el trackpad. -->
    <div class="flex gap-2.5" data-carrusel-flechas hidden>
      <button type="button" class={arrow} aria-label={t('home.projects.prev')} aria-controls="carrusel-proyectos" data-dir="-1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M19 12H5M11 6l-6 6 6 6"></path></svg
        >
      </button>
      <button type="button" class={arrow} aria-label={t('home.projects.next')} aria-controls="carrusel-proyectos" data-dir="1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </button>
    </div>
  </div>

  <ul id="carrusel-proyectos" class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-3">
    {
      featured.map((p) => (
        <li class="w-[270px] max-w-[85%] flex-none snap-start">
          <ProjectCard id={p.id} data={p.data} lang={lang} summary={false} />
        </li>
      ))
    }
  </ul>

  <a
    href={localizePath('/proyectos/', lang)}
    class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-link hover:text-ink"
  >
    {t('home.projects.all')}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
    >
  </a>
</section>

<script>
  const rail = document.getElementById('carrusel-proyectos');
  const arrows = document.querySelector<HTMLElement>('[data-carrusel-flechas]');
  if (rail && arrows) {
    arrows.hidden = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    arrows.querySelectorAll<HTMLButtonElement>('button[data-dir]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = rail.querySelector('li');
        const step = item ? item.getBoundingClientRect().width + parseFloat(getComputedStyle(rail).columnGap || '0') : 290;
        rail.scrollBy({ left: Number(button.dataset.dir) * step, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
  }
</script>
